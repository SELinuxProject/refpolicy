/etc/rc\.d/init\.d/lldpad	--	gen_context(system_u:object_r:lldpad_initrc_exec_t,s0)

/usr/bin/lldpad	--	gen_context(system_u:object_r:lldpad_exec_t,s0)

/usr/lib/systemd/system/lldpad\.service	--	gen_context(system_u:object_r:lldpad_unit_t,s0)
/usr/lib/systemd/system/lldpad\.socket	--	gen_context(system_u:object_r:lldpad_unit_t,s0)

/var/lib/lldpad(/.*)?	gen_context(system_u:object_r:lldpad_var_lib_t,s0)

/run/lldpad.*	gen_context(system_u:object_r:lldpad_runtime_t,s0)
