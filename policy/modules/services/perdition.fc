/etc/rc\.d/init\.d/perdition	--	gen_context(system_u:object_r:perdition_initrc_exec_t,s0)

/etc/perdition(/.*)?	gen_context(system_u:object_r:perdition_etc_t,s0)

/usr/bin/perdition.*	--	gen_context(system_u:object_r:perdition_exec_t,s0)

/usr/lib/systemd/system/perdition-imap4\.service	--	gen_context(system_u:object_r:perdition_unit_t,s0)
/usr/lib/systemd/system/perdition-imap4s\.service	--	gen_context(system_u:object_r:perdition_unit_t,s0)
/usr/lib/systemd/system/perdition-managesieve\.service	--	gen_context(system_u:object_r:perdition_unit_t,s0)
/usr/lib/systemd/system/perdition-pop3\.service	--	gen_context(system_u:object_r:perdition_unit_t,s0)
/usr/lib/systemd/system/perdition-pop3s\.service	--	gen_context(system_u:object_r:perdition_unit_t,s0)


/run/perdition\.pid	--	gen_context(system_u:object_r:perdition_runtime_t,s0)
